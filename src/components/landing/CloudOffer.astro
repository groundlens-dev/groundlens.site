---
// A floating launcher, bottom right, that opens a panel offering GroundLens
// measured and deployed in the visitor's own cloud. The request is sent to
// Web3Forms, which emails it to javier@groundlens.dev: the site is static
// (GitHub Pages), so it has no server of its own to receive a form.
// PUBLIC_WEB3FORMS_KEY is set at build time from the repository variable
// WEB3FORMS_KEY. Without it the form still shows the address to write to.
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
const email = "javier@groundlens.dev";
---
<div class="gl-nudge" id="gl-nudge" hidden>
  <button type="button" id="gl-nudge-x" aria-label="Dismiss">×</button>
  <strong>Running an assistant in production?</strong><br />
  We can measure how many wrong answers get through it, on your own data.
</div>

<button class="gl-launch" id="gl-launch" type="button" aria-expanded="false" aria-controls="gl-panel">
  <svg class="gauge" viewBox="0 0 34 34" aria-hidden="true">
    <circle cx="17" cy="17" r="14" fill="none" stroke="var(--line-strong)" stroke-width="4" />
    <circle cx="17" cy="17" r="14" fill="none" stroke="var(--green)" stroke-width="4" stroke-linecap="round"
      stroke-dasharray="66 88" transform="rotate(-90 17 17)" />
    <circle cx="17" cy="17" r="3.5" fill="var(--text)" />
  </svg>
  <span>GroundLens in your cloud<small>measured on your answers</small></span>
</button>

<aside class="gl-panel" id="gl-panel" role="dialog" aria-modal="false" aria-labelledby="gl-title" hidden>
  <div class="gl-head">
    <div class="eyebrow">For teams with an assistant in production</div>
    <h2 id="gl-title">Know how many wrong answers get through</h2>
    <p>We run GroundLens inside your own cloud and measure it on your real answers. Your documents and answers never leave your infrastructure.</p>
    <button class="gl-close" id="gl-close" type="button" aria-label="Close">×</button>
  </div>

  <div class="gl-proof">
    <span class="n bad">1 in 9</span><span class="t">answers were wrong before GroundLens</span>
    <span class="n good">1 in 26</span><span class="t">of the answers it let through were wrong</span>
    <a class="src" href="https://github.com/groundlens-dev/groundlens#measured-on">189 RAG answers it had never seen · intervals and method ↗</a>
  </div>

  <form class="gl-body" id="gl-form" data-key={key} novalidate>
    <fieldset>
      <legend>What do you need?</legend>
      <div class="opt"><input type="radio" name="plan" id="plan-measure" value="Measure" checked />
        <label for="plan-measure"><b>Measure</b><em>2 weeks</em><span>We take 100 of your real answers and tell you how many wrong ones get through today, and how many GroundLens would stop.</span></label></div>
      <div class="opt"><input type="radio" name="plan" id="plan-deploy" value="Deploy" />
        <label for="plan-deploy"><b>Deploy</b><em>fixed price</em><span>GroundLens running in your cloud, tuned to your documents, measured again at the end.</span></label></div>
      <div class="opt"><input type="radio" name="plan" id="plan-run" value="Keep it running" />
        <label for="plan-run"><b>Keep it running</b><em>monthly</em><span>Updates, support and a new measurement every quarter.</span></label></div>
    </fieldset>

    <div class="row"><label for="gl-email">Work email</label><input id="gl-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required /></div>
    <div class="row"><label for="gl-volume">Answers your assistant gives per day</label>
      <select id="gl-volume" name="volume"><option>Under 1,000</option><option selected>1,000 – 10,000</option><option>10,000 – 100,000</option><option>Over 100,000</option></select></div>
    <input type="checkbox" name="botcheck" class="gl-trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <button class="btn gl-submit" id="gl-submit" type="submit">Ask for a call</button>
    <p class="fine" id="gl-error" role="alert" hidden></p>
    <p class="fine">Reply within one working day. Or write directly to <code>{email}</code>.</p>
  </form>

  <div class="gl-done" id="gl-done" hidden>
    <div class="tick" aria-hidden="true">✓</div>
    <h3>Request sent</h3>
    <p id="gl-done-text">Javier will reply within one working day.</p>
  </div>
</aside>

<style>
  .gl-launch {
    position: fixed; z-index: 40;
    right: calc(20px + env(safe-area-inset-right, 0px));
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    display: flex; align-items: center; gap: 12px;
    padding: 10px 16px 10px 12px; border-radius: 999px;
    background: var(--bg-card); color: var(--text);
    border: 1px solid var(--line-strong);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(61, 127, 209, 0.12);
    font: 600 15px var(--sans); line-height: 1.3; cursor: pointer; text-align: left;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .gl-launch:hover { transform: translateY(-2px); border-color: var(--blue); }
  .gl-launch .gauge { width: 34px; height: 34px; flex: none; }
  .gl-launch small { display: block; font: 400 12px var(--mono); color: var(--muted); }
  .gl-launch[aria-expanded="true"] { opacity: 0; pointer-events: none; }

  .gl-nudge {
    position: fixed; z-index: 39;
    right: calc(20px + env(safe-area-inset-right, 0px));
    bottom: calc(84px + env(safe-area-inset-bottom, 0px));
    width: min(300px, calc(100vw - 40px));
    padding: 14px 30px 14px 16px; border-radius: 14px;
    background: var(--bg-raised); border: 1px solid var(--line-strong);
    font-size: 14px; line-height: 1.45; color: var(--muted); cursor: pointer;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    animation: gl-rise 0.35s ease both;
  }
  .gl-nudge strong { color: var(--text); }
  .gl-nudge button { position: absolute; top: 6px; right: 8px; background: none; border: 0; color: var(--faint); font-size: 18px; cursor: pointer; line-height: 1; }

  .gl-panel {
    position: fixed; z-index: 50;
    right: calc(20px + env(safe-area-inset-right, 0px));
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    width: min(400px, calc(100vw - 40px));
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    background: var(--bg-raised); border: 1px solid var(--line-strong); border-radius: 18px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.65);
    animation: gl-rise 0.28s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes gl-rise { from { transform: translateY(14px); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .gl-panel, .gl-nudge { animation: none; }
    .gl-launch { transition: none; }
  }

  .gl-head { padding: 20px 20px 16px; border-bottom: 1px solid var(--line); position: relative; }
  .gl-head .eyebrow { font: 500 11px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); padding-right: 36px; }
  .gl-head h2 { font-size: 22px; line-height: 1.15; letter-spacing: -0.02em; margin: 6px 0 8px; text-wrap: balance; }
  .gl-head p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
  .gl-close { position: absolute; top: 14px; right: 14px; width: 32px; height: 32px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg-card); color: var(--muted); font-size: 18px; cursor: pointer; }

  .gl-proof { margin: 16px 20px 0; padding: 12px 14px; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--line); display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; align-items: baseline; }
  .gl-proof .n { font: 500 22px var(--mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .gl-proof .n.bad { color: var(--red); }
  .gl-proof .n.good { color: var(--green); }
  .gl-proof .t { font-size: 13px; color: var(--muted); line-height: 1.35; }
  .gl-proof .src { grid-column: 1 / -1; font: 400 11px var(--mono); color: var(--faint); margin-top: 4px; text-decoration: none; }
  .gl-proof .src:hover { color: var(--muted); }

  .gl-body { padding: 16px 20px 20px; display: grid; gap: 14px; }
  .gl-body fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 8px; }
  .gl-body legend { font: 500 11px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); margin-bottom: 6px; padding: 0; }
  .opt { position: relative; }
  .opt input { position: absolute; opacity: 0; }
  .opt label {
    display: grid; grid-template-columns: 1fr auto; gap: 2px 10px;
    padding: 11px 14px; border-radius: 12px; border: 1px solid var(--line);
    background: var(--bg-card); cursor: pointer;
  }
  .opt label b { font-size: 15px; }
  .opt label span { grid-column: 1; font-size: 13px; color: var(--muted); line-height: 1.4; }
  .opt label em { grid-row: 1; grid-column: 2; font: normal 500 12px var(--mono); color: var(--faint); align-self: center; }
  .opt input:checked + label { border-color: var(--blue); box-shadow: inset 0 0 0 1px var(--blue); }
  .opt input:focus-visible + label { outline: 2px solid var(--blue); outline-offset: 2px; }

  .row { display: grid; gap: 6px; }
  .row label { font-size: 13px; color: var(--muted); }
  .row input, .row select {
    width: 100%; padding: 10px 12px; border-radius: 10px;
    border: 1px solid var(--line-strong); background: var(--bg); color: var(--text);
    font: 15px var(--sans);
  }
  .gl-trap { position: absolute; left: -9999px; }
  .gl-submit { width: 100%; justify-content: center; background: var(--text); color: var(--bg); border-color: var(--text); }
  .gl-submit:hover { background: #fff; }
  .gl-submit[disabled] { opacity: 0.6; cursor: progress; }
  .fine { font-size: 12px; color: var(--faint); line-height: 1.45; margin: 0; }
  .fine code { font-family: var(--mono); color: var(--muted); user-select: all; }
  #gl-error { color: var(--red); }

  .gl-done { padding: 28px 20px; display: grid; gap: 10px; }
  .gl-done .tick { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: rgba(63, 178, 127, 0.12); color: var(--green); font-size: 20px; }
  .gl-done h3 { margin: 0; font-size: 19px; }
  .gl-done p { margin: 0; color: var(--muted); font-size: 14px; }

  @media (max-width: 520px) {
    .gl-panel {
      right: 0; left: 0; bottom: 0; width: auto; border-radius: 18px 18px 0 0;
      padding-bottom: env(safe-area-inset-bottom, 0px); max-height: 88vh;
    }
    .gl-launch small { display: none; }
  }
</style>

<script>
  const $ = (id: string) => document.getElementById(id);
  const launch = $("gl-launch") as HTMLButtonElement;
  const panel = $("gl-panel") as HTMLElement;
  const nudge = $("gl-nudge") as HTMLElement;
  const form = $("gl-form") as HTMLFormElement;
  const SEEN = "gl-nudge-seen";
  const store = {
    get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
    set(k: string, v: string) { try { localStorage.setItem(k, v); } catch {} },
  };

  function open() {
    panel.hidden = false;
    nudge.hidden = true;
    launch.setAttribute("aria-expanded", "true");
    store.set(SEEN, "1");
    ($("plan-measure") as HTMLInputElement).focus({ preventScroll: true });
  }
  function close() {
    panel.hidden = true;
    launch.setAttribute("aria-expanded", "false");
    launch.focus({ preventScroll: true });
  }
  launch.addEventListener("click", open);
  nudge.addEventListener("click", (e) => { if ((e.target as HTMLElement).id !== "gl-nudge-x") open(); });
  $("gl-nudge-x")?.addEventListener("click", () => { nudge.hidden = true; store.set(SEEN, "1"); });
  $("gl-close")?.addEventListener("click", close);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) close(); });

  // The nudge shows once per visitor, a few seconds after the page loads.
  if (!store.get(SEEN)) setTimeout(() => { if (panel.hidden) nudge.hidden = false; }, 4000);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = $("gl-email") as HTMLInputElement;
    const error = $("gl-error") as HTMLElement;
    const submit = $("gl-submit") as HTMLButtonElement;
    error.hidden = true;
    if (!email.value || !email.checkValidity()) {
      error.textContent = "Write a work email so we can reply.";
      error.hidden = false;
      email.focus();
      return;
    }
    const key = form.dataset.key;
    if (!key) {
      error.textContent = "The form is not connected yet. Please write to javier@groundlens.dev.";
      error.hidden = false;
      return;
    }
    const data = new FormData(form);
    const plan = String(data.get("plan"));
    const volume = String(data.get("volume"));
    submit.disabled = true;
    submit.textContent = "Sending…";
    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          access_key: key,
          subject: `GroundLens: ${plan} request`,
          from_name: "groundlens.dev",
          email: email.value,
          plan,
          volume,
          page: location.pathname,
          botcheck: data.get("botcheck") ? "on" : "",
        }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error(json.message || "send failed");
      form.hidden = true;
      ($("gl-done") as HTMLElement).hidden = false;
    } catch {
      error.textContent = "It did not go through. Please write to javier@groundlens.dev.";
      error.hidden = false;
      submit.disabled = false;
      submit.textContent = "Ask for a call";
    }
  });
</script>
