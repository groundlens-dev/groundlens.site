<script is:inline>
  function glCopy(text, el) {
    navigator.clipboard.writeText(text);
    var old = el.textContent;
    el.textContent = "Copied";
    setTimeout(function () { el.textContent = old; }, 1400);
  }
  function glCopyInstall(e) { glCopy("pip install groundlens", e.currentTarget); }
  function glCopyMcp(e) { glCopy('pip install "groundlens[encoder,mcp]"', e.currentTarget); }
</script>
