---
import "../styles/index.css";

import { getCollection } from "astro:content";
import { name, openGraph } from "spectre:globals";
import ProfilePicture from "../assets/pfp.png";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import ImageGlow from "../components/ImageGlow.astro";
import Layout from "../layouts/Layout.astro";

const [posts, quickInfo, socials] = await Promise.all([
	getCollection("posts", (post) => post.data.draft !== true),
	getCollection("quickInfo"),
	getCollection("socials"),
]);

const SPACE_URL = "https://groundlens-groundlens-mcp.hf.space";
---

<Layout
	title={openGraph.home.title || name}
	description={openGraph.home.description}
	pagefindIgnore
>
	<div class="layout-grid-left" slot="left">
		<Card class="flex-col-card">
			<ImageGlow
				quality={100}
				width={120}
				height={120}
				src={ProfilePicture}
				alt="groundlens — geometric LLM hallucination detection"
				loading="eager"
			/>
			<h2>{name}</h2>
			<ul class="overview-list">
				{
					quickInfo.map((info) => (
						<li>
							<Icon
								type={info.data.icon.type}
								name={info.data.icon.name as any}
								width={24}
								height={24}
								class="glow-icon"
							/>
							<span>{info.data.text}</span>
						</li>
					))
				}
			</ul>
		</Card>
		<Card>
			<h3 class="no-mt">Socials</h3>
			<ul class="overview-list">
				{
					socials.map((item) => (
						<li>
							<a href={item.data.link} class="socials-link">
								<Icon
									type={item.data.icon.type}
									name={item.data.icon.name as any}
									width={24}
									height={24}
									class="glow-icon"
								/>
								<span>{item.data.text}</span>
							</a>
						</li>
					))
				}
			</ul>
		</Card>
	</div>
	<div class="layout-grid-right" slot="right">
		<Card>
			<h1 class="hero-title">Check your LLM without a second LLM.</h1>
			<p class="hero-sub">
				Groundlens ranks answers by how grounded they are, read straight from the
				geometry of the embeddings. Deterministic. Sub second. Auditable. And it
				tells you the few cases that still need your expensive second stage.
			</p>
			<div class="cta-row">
				<a href="#demo" class="btn btn-primary">Run the demo</a>
				<a href="https://github.com/groundlens-dev/groundlens" class="btn">GitHub</a>
				<a href="https://docs.groundlens.dev" class="btn">Docs</a>
			</div>
			<pre class="install"><code>pip install groundlens</code></pre>
		</Card>

		<Card>
			<div class="header-container" id="demo">
				<Icon type="lucide" name="play" width={24} height={24} class="glow-icon" />
				<h2>Run it. Don't take my word.</h2>
			</div>
			<p class="prose">
				Give it a question, a source, and an answer. Watch the score come out the
				same every time.
			</p>
			<div class="demo-frame">
				<iframe
					src={SPACE_URL}
					title="Groundlens live demo"
					width="100%"
					height="620"
					loading="lazy"
					frameborder="0"
				></iframe>
			</div>
		</Card>

		<Card>
			<div class="header-container">
				<Icon type="lucide" name="git-fork" width={24} height={24} class="glow-icon" />
				<h2>One idea, two lenses.</h2>
			</div>
			<p class="prose">
				Grounding is displacement in embedding space. With a source to check
				against, <strong>SGI</strong> measures it. Without one, <strong>DGI</strong>
				reads it from the answer alone. The same geometry, read twice. No judge
				model in the loop, ever.
			</p>
		</Card>

		<Card>
			<div class="header-container">
				<Icon type="lucide" name="badge-check" width={24} height={24} class="glow-icon" />
				<h2>Backed, not asserted.</h2>
			</div>
			<p class="prose">
				Three peer reviewed papers, one open benchmark. AUROC 0.90 to 0.99 with
				domain calibration, 0.76 generic. Deterministic by construction: the same
				input gives the same score, forever.
			</p>
		</Card>

		<Card>
			<div class="header-container">
				<Icon type="lucide" name="shield-alert" width={24} height={24} class="glow-icon" />
				<h2>The first stage, not the only stage.</h2>
			</div>
			<p class="prose">
				Groundlens is the cheap, deterministic first pass. It catches semantic
				disengagement in one shot, no judge model, and escalates only what is left,
				a factual error inside the right conceptual frame, to your expensive second
				stage. You spend the slow, costly check on the few cases that need it, not on
				everything.
			</p>
		</Card>

		<Card>
			<div class="header-container">
				<Icon type="lucide" name="terminal" width={24} height={24} class="glow-icon" />
				<h2>Use it.</h2>
			</div>
			<p class="prose">
				Open source, Apache 2.0. A Python library, a CLI, and an MCP server for your
				agent.
			</p>
			<div class="cta-row">
				<a href="https://pypi.org/project/groundlens/" class="btn">PyPI</a>
				<a href="https://github.com/groundlens-dev/groundlens" class="btn">GitHub</a>
				<a href="https://docs.groundlens.dev" class="btn">Docs</a>
			</div>
		</Card>

		<Card>
			<div class="header-container">
				<Icon type="lucide" name="rss" width={24} height={24} class="glow-icon" />
				<h2>Writing</h2>
			</div>
			<div class="content-container">
				{
					posts
						.sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime())
						.slice(0, 3)
						.map((post) => (
							<a href={`/blog/${post.id}`} class="post-container">
								<div class="post-header">
									<h3>{post.data.title}</h3>
									<span class="post-date">
										{post.data.createdAt.toLocaleDateString()}
									</span>
								</div>
								<span>{post.data.description}</span>
							</a>
						))
				}
			</div>
		</Card>
	</div>
</Layout>

<style>
	.hero-title { font-size: 2rem; line-height: 1.15; margin: 0 0 0.75rem; }
	.hero-sub { font-size: 1.05rem; opacity: 0.85; margin: 0 0 1.25rem; }
	.cta-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem; }
	.btn {
		display: inline-block; padding: 0.5rem 1rem; border-radius: 8px;
		border: 1px solid rgba(255,255,255,0.15); text-decoration: none;
		font-weight: 600; font-size: 0.95rem;
	}
	.btn-primary { background: var(--primary, #7f5af0); border-color: transparent; color: #fff; }
	.install { margin: 0; padding: 0.75rem 1rem; border-radius: 8px; overflow-x: auto; }
	.demo-frame { border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.12); }
	.demo-frame iframe { display: block; width: 100%; }
</style>
