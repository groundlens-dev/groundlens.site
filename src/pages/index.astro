    <!-- HERO -->
    <section data-col data-hero style="display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.05fr); gap:56px; align-items:center; padding:88px 0 56px;">
      <div>
        <div style="display:inline-flex; align-items:center; gap:8px; padding:5px 12px; border:1px solid #232a32; border-radius:999px; font-family:'IBM Plex Mono',monospace; font-size:12px; color:#9aa4b0; margin-bottom:26px;">
          <span style="width:6px; height:6px; border-radius:50%; background:#fc7604; display:inline-block;"></span>
          open source · Apache-2.0
        </div>
        <h1 style="font-size:clamp(2rem,4.4vw,3.15rem); line-height:1.08; letter-spacing:-0.025em; font-weight:600; margin:0 0 20px;">
          Check whether an LLM's answer actually came from its source.
        </h1>
        <p style="font-size:19px; color:#c2c9d1; margin:0 0 10px; line-height:1.45; max-width:40ch;">
          Fast, deterministic, no second LLM.
        </p>
        <p style="font-size:15px; color:#8892a0; margin:0 0 32px; font-family:'IBM Plex Mono',monospace;">
          For RAG systems and agent loops in regulated industries.
        </p>

        <div style="display:flex; align-items:stretch; gap:0; max-width:440px; border:1px solid #262d35; border-radius:10px; overflow:hidden; background:#0f1318;">
          <div style="display:flex; align-items:center; padding:0 16px; font-family:'IBM Plex Mono',monospace; font-size:15px; color:#e8ebef; flex:1;">
            <span style="color:#6b7684; margin-right:10px;">$</span>pip install groundlens
          </div>
          <button onclick="glCopyInstall(event)" style="border:0; border-left:1px solid #262d35; background:#fc7604; color:#0a0c0e; font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:13px; padding:0 18px; cursor:pointer; letter-spacing:0.02em;">Copy</button>
        </div>
