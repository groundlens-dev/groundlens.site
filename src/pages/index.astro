    <section data-col data-hero style="display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.05fr); gap:56px; align-items:center; padding:88px 0 56px;">
      <div>
        <div style="display:inline-flex; align-items:center; gap:8px; padding:5px 12px; border:1px solid #232a32; border-radius:999px; font-family:'IBM Plex Mono',monospace; font-size:12px; color:#9aa4b0; margin-bottom:26px;">
          <span style="width:6px; height:6px; border-radius:50%; background:#fc7604; display:inline-block;"></span>
          open source · Apache-2.0
        </div>
