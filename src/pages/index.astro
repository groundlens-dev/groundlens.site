          <a href="https://huggingface.co/spaces/groundlens/demo" style="font-size:14px; font-weight:500; color:#c2c9d1; display:inline-flex; align-items:center; gap:8px;"><img src="https://www.google.com/s2/favicons?domain=huggingface.co&sz=64" alt="" style="height:17px; width:17px; border-radius:3px;" onerror="this.style.display='none'">Try the live demo <span aria-hidden="true">&rarr;</span></a>
          <a href="https://docs.groundlens.dev" style="font-size:14px; font-weight:500; color:#9aa4b0;">Read the docs</a>
        </div>
      </div>

      <div>
        <figure style="margin:0;">
          <div style="border:1px solid #1e242b; border-radius:12px; overflow:hidden; background:#0d1014; box-shadow:0 24px 60px -20px rgba(0,0,0,0.7);">
            <div style="display:flex; align-items:center; gap:8px; padding:10px 14px; border-bottom:1px solid #171c22; background:#0f1318;">
              <span style="width:9px; height:9px; border-radius:50%; background:#2a323b;"></span>
              <span style="width:9px; height:9px; border-radius:50%; background:#2a323b;"></span>
              <span style="width:9px; height:9px; border-radius:50%; background:#2a323b;"></span>
              <span style="margin-left:8px; font-family:'IBM Plex Mono',monospace; font-size:12px; color:#6b7684;">Claude · Groundlens MCP</span>
            </div>
            <img src="https://raw.githubusercontent.com/groundlens-dev/groundlens/main/examples/groundlens_check.gif" alt="A deterministic CHECK printed live under every answer inside Claude" style="display:block; width:100%; height:auto;">
          </div>
          <figcaption style="margin-top:14px; font-family:'IBM Plex Mono',monospace; font-size:12.5px; color:#6b7684; line-height:1.5;">A deterministic CHECK printed under every answer, live inside Claude.</figcaption>
        </figure>
      </div>
