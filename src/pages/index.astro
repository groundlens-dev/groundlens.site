---
// The landing page. Its text is the same as public/index.md, the Markdown
// twin served to language models: change one, change the other.
import CloudOffer from "../components/landing/CloudOffer.astro";
import Footer from "../components/landing/Footer.astro";
import Head from "../components/landing/Head.astro";
import Mark from "../components/landing/Mark.astro";
import Nav from "../components/landing/Nav.astro";

const title = "GroundLens — Guardrails for LLM answers";
const sentence =
	"GroundLens checks an LLM answer against its sources without a model, decides PASS, REVIEW or FAIL under your policy, and keeps a signed record.";
const github = "https://github.com/groundlens-dev/groundlens";
const docs = "https://groundlens.readthedocs.io/en/latest";
const gif = "https://raw.githubusercontent.com/groundlens-dev/groundlens/main/docs/assets/langfuse.gif";

const faq = [
	{
		q: "Is GroundLens a hallucination detector?",
		a: "It is narrower and stricter. It checks the figures in an answer against the passages the answer was written from, and the policy decides what a mismatch means. For sentences without figures, connect your own LLM judge.",
	},
	{
		q: "Does it need a GPU, a model or an API key?",
		a: "No. The checks are exact and run in your process in about a millisecond. A judge is optional, and it is the model you already use.",
	},
	{
		q: "Does any data leave my machine?",
		a: "No. The engine has no network code. Other systems are reached only through clients you create and pass in.",
	},
	{
		q: "Is it deterministic?",
		a: "The checks are: the same answer, passages and policy give the same content hash on Linux, macOS and Windows. A judge is not, and the record says so.",
	},
	{
		q: "How is it different from Guardrails AI, NeMo Guardrails, Ragas or DeepEval?",
		a: "Those score or filter answers, mostly with a model. GroundLens decides with exact checks, under a policy you version, and leaves a signed record of why. It works next to them.",
	},
	{
		q: "Does it work with LangChain, LlamaIndex or my own stack?",
		a: "Yes. It is one call after your model answers: verifier.check(answer=..., passages=...).",
	},
	{
		q: "What does it cost?",
		a: "The software costs nothing. Apache-2.0: engine, checks, policies, connectors, command line and MCP server. Measuring it on your answers and running it in your cloud is a paid service: write to javier@groundlens.dev.",
	},
];

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		name: "GroundLens",
		alternateName: "groundlens",
		description: sentence,
		applicationCategory: "DeveloperApplication",
		applicationSubCategory: "LLM guardrails",
		operatingSystem: "Linux, macOS, Windows",
		programmingLanguage: ["Python", "Rust"],
		url: "https://groundlens.dev/",
		downloadUrl: "https://pypi.org/project/groundlens/",
		codeRepository: github,
		license: "https://www.apache.org/licenses/LICENSE-2.0",
		isAccessibleForFree: true,
		offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
		keywords:
			"LLM guardrails, RAG answer verification, hallucination detection without an LLM, LLM-as-a-judge, deterministic LLM evaluation, EU AI Act record keeping, AI audit trail, signed records, Langfuse, OpenTelemetry, MCP",
		author: { "@type": "Person", name: "Javier Marín", email: "javier@groundlens.dev" },
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: faq.map(({ q, a }) => ({
			"@type": "Question",
			name: q,
			acceptedAnswer: { "@type": "Answer", text: a },
		})),
	},
];
---
<!doctype html>
<html lang="en">
<head>
  <Head title={title} description={sentence} path="/" markdown="/index.md" jsonLd={jsonLd} />
</head>
<body>
  <Nav />

  <main>
    <div class="hero">
      <div class="wrap">
        <Mark class="hero-mark" />
        <h1>Guardrails for<br />LLM answers.</h1>
        <p class="lede">{sentence}</p>
        <div class="actions">
          <button class="btn btn-light install" type="button" data-copy="pip install groundlens" aria-label="Copy the install command">
            <span><span class="prompt">$</span> pip install groundlens</span>
            <span class="copy" aria-hidden="true">copy</span>
          </button>
          <a class="btn" href={github}>Read the source ↗</a>
        </div>
        <p class="facts"><span>Free, Apache-2.0</span><span>No model</span><span>No network</span><span>Python 3.10+</span></p>

        <figure class="window">
          <img src={gif} width="1280" height="600" loading="eager"
            alt="Langfuse showing GroundLens checks of a credit assistant: traces filtered by level, a FAIL opened with its reasons, its score and the time each check took." />
        </figure>
        <p class="caption">Each check inside the Langfuse trace of the answer it checked: the decision, the reasons and the time each step took.</p>
      </div>
    </div>

    <section>
      <div class="wrap">
        <p class="kicker">Why GroundLens</p>
        <h2>A decision you can defend,<br />not another score.</h2>
        <div class="tiles">
          <div class="tile"><div class="label">Deterministic</div><div class="value">Exact checks</div><p>First, with no LLM judge needed. The same answer gets the same result on every machine.</p></div>
          <div class="tile"><div class="label">Provable</div><div class="value">Signed record</div><p>PASS, REVIEW or FAIL, with reasons, hashed and chained before the decision returns.</p></div>
          <div class="tile"><div class="label">Measured</div><div class="value">Known error rate</div><p>You know the share of wrong answers among those that passed, with a confidence interval.</p></div>
          <div class="tile"><div class="label">Portable</div><div class="value">Rust engine</div><p>One implementation for Python and the command line, on Linux, macOS and Windows.</p></div>
        </div>
      </div>
    </section>

    <section id="how">
      <div class="wrap">
        <p class="kicker">How it works</p>
        <h2>Five steps between the answer<br />and anyone who acts on it.</h2>
        <p class="sub">Your model writes an answer from the passages your retriever found. Before anyone acts on it, GroundLens:</p>
        <div class="split">
          <ol class="steps">
            <li><b>Checks every figure.</b> It must be in the passages, or follow from figures that are: a sum, a difference, a ratio, a percentage change, compared as exact fractions in the locale and units the documents use.</li>
            <li><b>Checks where each figure came from.</b> A real figure taken from another company, contract or year fails.</li>
            <li><b>Checks it is what was asked.</b> A percentage when the question asked for a percentage; euros when it asked for euros.</li>
            <li><b>Applies your policy.</b> PASS, REVIEW or FAIL, with the reasons a reviewer reads first.</li>
            <li><b>Signs and stores the record</b> before it returns the decision. No stored record, no decision.</li>
          </ol>
          <div>
<pre><code><span class="c-k">import</span> groundlens <span class="c-k">as</span> gl

verifier = gl.<span class="c-f">Verifier</span>(sink=gl.sinks.<span class="c-f">jsonl</span>(<span class="c-s">"records/"</span>))
record = verifier.<span class="c-f">check</span>(
    answer=<span class="c-s">"Revenue was €42.1 million."</span>,
    passages=[<span class="c-s">"Revenue reached €41.2 million."</span>],
)
<span class="c-f">print</span>(record.decision, record.reasons)</code></pre>
<pre class="out"><code><span class="fail">FAIL</span> ['c2: groundlens.numeric contradicted:
  €42.1 million not in sources; nearest 41200000 EUR
  in ctx-0 (relative distance 0.021)']</code></pre>
          </div>
        </div>

        <div class="table-box">
          <table class="facts-table">
            <tbody>
              <tr><td>For</td><td>Teams whose LLM answers carry figures: finance, credit, insurance, legal, procurement, reporting.</td></tr>
              <tr><td>Runs</td><td>In your process. Python 3.10+, Linux, macOS, Windows. No server, no account, no API key, no model, no network.</td></tr>
              <tr><td>Works with</td><td>Langfuse, Grafana and any OpenTelemetry backend, MCP clients, your LLM judge (OpenAI-compatible, Azure OpenAI, Bedrock), AWS KMS, Azure Key Vault, PKCS#11 HSMs, S3 Object Lock, Azure Blob, Postgres.</td></tr>
              <tr><td>Engine</td><td>Rust. One implementation: the same answer gives the same content hash on every machine.</td></tr>
              <tr><td>Price</td><td>Free. Apache-2.0, all of it.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="judge">
      <div class="wrap">
        <p class="kicker">Already running an LLM-as-judge?</p>
        <h2>Keep it. Let GroundLens check first.</h2>
        <p>A FAIL never reaches the judge. Your judge only sees the answers the exact checks could not reject, and it can escalate an answer, never pass one. Every call is recorded: the template, the hash of the prompt, the model that answered and the hash of its reply.</p>
        <div class="flow" aria-label="Answer, then exact checks, then the judge only if they did not fail, then the policy and the signed record">
          <span class="node">answer</span><span class="arrow">→</span>
          <span class="node">exact checks</span><span class="arrow">→</span>
          <span class="node">judge, if not FAIL</span><span class="arrow">→</span>
          <span class="node">policy</span><span class="arrow">→</span>
          <span class="node">signed record</span>
        </div>
      </div>
    </section>

    <section id="catches">
      <div class="wrap">
        <p class="kicker">What it catches, and what it does not</p>
        <h2>Exact where it can be.<br />Clear about where it cannot.</h2>
        <div class="table-box">
          <table>
            <thead><tr><th>Error in the answer</th><th>Caught by</th></tr></thead>
            <tbody>
              <tr><td>A figure that is not in the passages</td><td><span class="tag fail">FAIL</span> exact check</td></tr>
              <tr><td>Wrong arithmetic: a sum, ratio or percentage change that does not follow</td><td><span class="tag fail">FAIL</span> exact check</td></tr>
              <tr><td>A real figure from another company, contract or year</td><td><span class="tag fail">FAIL</span> scope check</td></tr>
              <tr><td>A figure of another kind or unit than the question asked for</td><td><span class="tag review">REVIEW</span> intent check</td></tr>
              <tr><td>A request that does not say which entity it is about, when the policy requires it</td><td><span class="tag review">REVIEW</span> policy</td></tr>
              <tr><td>A record edited, deleted or reordered after the fact</td><td><span class="tag fail">detected</span> <code>record verify</code>, offline</td></tr>
              <tr class="limit"><td>A real figure from the wrong row of the right table</td><td><span class="tag none">your judge</span></td></tr>
              <tr class="limit"><td>A sentence the passages never say</td><td><span class="tag none">your judge</span></td></tr>
              <tr class="limit"><td>A fact that is wrong in the passages themselves</td><td><span class="tag none">nothing</span> it checks against your passages, not the world</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <p class="kicker">Works with</p>
        <h2>Where you already look.</h2>
        <div class="cards">
          <div class="card"><h3>Langfuse</h3><p>Each check in the trace that produced the answer, as a guardrail observation, with the decision as a categorical score.</p><code>pip install "groundlens[langfuse]"</code></div>
          <div class="card"><h3>Grafana and OpenTelemetry</h3><p>Spans and metrics through the providers your application already uses, and a ready dashboard.</p><code>pip install "groundlens[otel]"</code></div>
          <div class="card"><h3>MCP</h3><p>Any MCP client gets three tools: <code>verify_answer</code>, <code>verify_run</code>, <code>verify_records</code>.</p><code>pip install "groundlens[mcp]"</code></div>
          <div class="card"><h3>Your judge</h3><p>OpenAI and any compatible server (vLLM, Ollama, your gateway), Azure OpenAI, Bedrock. You pass the client you already use.</p><code>gl.judges.openai_compatible(client, model)</code></div>
          <div class="card"><h3>Your keys</h3><p>Records signed in AWS KMS, Azure Key Vault or a PKCS#11 HSM. The key never leaves it.</p><code>gl.signers.aws_kms(client, key_id)</code></div>
          <div class="card"><h3>Your storage</h3><p>S3 Object Lock, Azure Blob, Postgres or JSON Lines. Written once, never overwritten.</p><code>gl.sinks.s3_object_lock(client, bucket)</code></div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <p class="kicker">For regulated teams</p>
        <h2>Evidence an auditor can check<br />without your software.</h2>
        <div class="split">
          <p class="sub">The <code>eu_ai_act_high_risk_v1</code> policy maps each decision to Regulation (EU) 2024/1689. It produces evidence for those controls; it does not make a system compliant on its own.</p>
          <div class="table-box" style="margin-top:0">
            <table>
              <tbody>
                <tr><td><span class="tag fail">FAIL</span></td><td>Art. 15(1) accuracy</td></tr>
                <tr><td><span class="tag review">REVIEW</span></td><td>Art. 14(4)(a) human oversight</td></tr>
                <tr><td><span class="tag pass">every record</span></td><td>Art. 12(1) record keeping</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <p class="sub" style="margin-top:32px">Every record carries a content hash, the hash of the record before it and a signature. Anyone can check a whole log offline with the public key alone, with <code>groundlens record verify</code> or with <code>glv</code>, a single binary that needs no Python. <code>groundlens measure</code> estimates the share of wrong answers among those that passed, from a small sample your team labels.</p>
      </div>
    </section>

    <section id="faq">
      <div class="wrap">
        <p class="kicker">FAQ</p>
        <h2>Before you install.</h2>
        <div class="faq">
          {faq.map(({ q, a }) => (
            <div><h3>{q}</h3><p>{a}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section id="agents">
      <div class="wrap">
        <p class="kicker">For agents</p>
        <h2>Readable by people and by models.</h2>
        <div class="agents">
          <p class="sub">Every page here has a Markdown twin, and <code>llms.txt</code> says when to use GroundLens and when not to. An agent can also call it directly over MCP.</p>
          <ul class="links">
            <li><a href="/llms.txt">/llms.txt</a><span>when to use it, how to call it</span></li>
            <li><a href="/index.md">/index.md</a><span>this page as Markdown</span></li>
            <li><a href="/compare.md">/compare.md</a><span>GroundLens and other tools</span></li>
            <li><a href={docs}>readthedocs</a><span>guides and reference</span></li>
            <li><a href="https://pypi.org/project/groundlens/">pypi</a><span>pip install groundlens</span></li>
            <li><code>io.github.groundlens-dev/groundlens</code><span>MCP registry</span></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <CloudOffer />

  <script>
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      button.addEventListener("click", async () => {
        const label = button.querySelector(".copy");
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          if (label) label.textContent = "copied";
        } catch {
          if (label) label.textContent = "select it";
        }
        setTimeout(() => { if (label) label.textContent = "copy"; }, 1600);
      });
    }
  </script>
</body>
</html>
